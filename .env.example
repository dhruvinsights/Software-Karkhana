# Copy this file to .env and fill in real values.
# .env is git-ignored. Never commit secrets.

# --- Gemini (required for AI features) ------------------------------------
# AI Studio injects this automatically at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Google Cloud ---------------------------------------------------------
# APP_URL is injected automatically by Cloud Run.
APP_URL="MY_APP_URL"

# --- Auth secrets ---------------------------------------------------------
# Two separate keys. SESSION_JWT_SECRET signs user sessions; RUN_HMAC_SECRET
# signs per-run worker callback tokens. They must differ. Outside AUTH_MODE=dev
# the built-in session default is refused; on Cloud Run both come from
# Secret Manager (session-jwt-secret, run-hmac-secret; see infra/bootstrap.sh).
# Generate with: openssl rand -hex 32
SESSION_JWT_SECRET="change-me-session-secret"
RUN_HMAC_SECRET="change-me-run-secret"

# --- React Bits Pro (frontend component library) --------------------------
# Put the real key in .env.local (also git-ignored). Never commit it.
REACTBITS_LICENSE_KEY="MY_REACTBITS_LICENSE_KEY"

# --- Email (Resend) --------------------------------------------------------
# Transactional email for invites, notifications, and magic links.
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"

# Sender address — must use a domain verified in your Resend dashboard.
# Go to https://resend.com/domains and add software-karkhana.com.
EMAIL_FROM="onboarding@software-karkhana.com"

# --- Google OAuth -----------------------------------------------------------
# Used for Sign-in with Google. Create credentials at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Frontend Vite env (must be prefixed VITE_ to be exposed to the browser)
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# --- Token encryption at rest ----------------------------------------------
# Comma-separated Fernet keys that encrypt stored GitHub OAuth tokens. The first
# encrypts; all decrypt (rotation). Required outside AUTH_MODE=dev. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=""

# Chat: history kept this many days, then purged hourly.
CHAT_RETENTION_DAYS=90
# Cross-instance chat fan-out. Unset = single instance. Local: `make broker-local`.
# REALTIME_BROKER_URL=kafka://localhost:19092

# --- Agents on local models (Ollama) --------------------------------------
# LLM_PROVIDER=ollama
# EMBED_PROVIDER=ollama
# REVIEW_ENGINE=adk            # or pr_agent (scripts/setup_pr_agent.sh)
# GITHUB_REVIEWERS=alice,bob   # asked to review every PR Karkhana opens
# Agent memory (scripts/setup_mem0.sh prints the path):
# MEM0_PYTHON=/abs/path/.venv-mem0/bin/python
# MEM0_STORE=qdrant            # or pgvector with MEM0_DSN=postgresql://...
