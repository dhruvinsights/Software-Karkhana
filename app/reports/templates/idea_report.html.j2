<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ idea.title }} · Idea evaluation</title>
<style>
  @page { size: A4; margin: 22mm 18mm 20mm 18mm; }
  :root {
    --ink: #14161c; --ink-2: #3d4250; --ink-3: #6b7180; --rule: #e3e5ea; --wash: #f5f6f8;
    --accent: #0b5cff; --go: #137a43; --cond: #a15c00; --more: #3d4f7a; --nogo: #b42318;
  }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    margin: 0; color: var(--ink); font: 10pt/1.55 "Inter", -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-feature-settings: "tnum" 1, "cv11" 1;
  }
  h1, h2, h3 { margin: 0; font-weight: 650; letter-spacing: -0.01em; }
  p { margin: 0 0 6pt; }
  code, .mono { font: 8.6pt/1.4 "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace; }

  .cover { border-bottom: 1px solid var(--rule); padding-bottom: 14pt; margin-bottom: 16pt; }
  .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: 7.5pt; color: var(--accent); font-weight: 650; }
  .cover h1 { font-size: 22pt; line-height: 1.15; margin: 6pt 0 10pt; }
  .meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8pt 14pt; font-size: 8pt; color: var(--ink-3); }
  .meta b { display: block; color: var(--ink); font-weight: 600; font-size: 8.6pt; word-break: break-word; }

  .headline { display: grid; grid-template-columns: 1fr 150pt; gap: 16pt; align-items: stretch; margin-bottom: 18pt; }
  .summary { font-size: 10.5pt; line-height: 1.6; color: var(--ink-2); }
  .verdict { border-radius: 8pt; padding: 12pt 14pt; color: #fff; display: flex; flex-direction: column; justify-content: space-between; }
  .verdict .label { font-size: 7.5pt; text-transform: uppercase; letter-spacing: .1em; opacity: .85; }
  .verdict .value { font-size: 14pt; font-weight: 700; line-height: 1.2; margin-top: 4pt; }
  .verdict .score { font-size: 26pt; font-weight: 700; line-height: 1; margin-top: 10pt; }
  .verdict .score small { font-size: 10pt; font-weight: 500; opacity: .8; }
  .v-go { background: var(--go); } .v-cond { background: var(--cond); } .v-more { background: var(--more); } .v-nogo { background: var(--nogo); }

  section { margin-top: 16pt; }
  section > h2 { font-size: 12.5pt; padding-bottom: 5pt; border-bottom: 1.5px solid var(--ink); margin-bottom: 9pt; display: flex; gap: 8pt; break-after: avoid; }
  section > h2 .n { color: var(--accent); font-variant-numeric: tabular-nums; }
  h3 { font-size: 9.5pt; margin: 10pt 0 4pt; color: var(--ink); break-after: avoid; }
  .lead { color: var(--ink-2); }

  .scores { display: grid; gap: 7pt; }
  .score-row { display: grid; grid-template-columns: 110pt 1fr 28pt; gap: 10pt; align-items: center; break-inside: avoid; }
  .score-row .name { font-weight: 600; font-size: 9pt; }
  .score-row .name small { display: block; font-weight: 400; color: var(--ink-3); font-size: 7.5pt; }
  .bar { height: 7pt; background: var(--wash); border-radius: 4pt; overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--accent); border-radius: 4pt; }
  .bar i.inv { background: #8a93a6; }
  .score-row .num { text-align: right; font-weight: 650; }
  .rationale { grid-column: 2 / 4; font-size: 8.4pt; color: var(--ink-3); margin-top: -3pt; }

  ul.clean { margin: 0; padding-left: 13pt; } ul.clean li { margin: 2pt 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 14pt; }
  .card { background: var(--wash); border-radius: 6pt; padding: 9pt 11pt; break-inside: avoid; }
  .card h3 { margin-top: 0; }

  table { width: 100%; border-collapse: collapse; font-size: 8.8pt; margin: 4pt 0 6pt; }
  th { text-align: left; font-weight: 600; color: var(--ink-3); font-size: 7.5pt; text-transform: uppercase; letter-spacing: .06em; padding: 5pt 6pt; border-bottom: 1px solid var(--ink); }
  td { padding: 6pt; border-bottom: 1px solid var(--rule); vertical-align: top; }
  tr { break-inside: avoid; }
  .chip { display: inline-block; padding: 1pt 6pt; border-radius: 10pt; font-size: 7.4pt; font-weight: 600; white-space: nowrap; }
  .c-low { background: #e7f4ec; color: var(--go); } .c-medium { background: #fdf1e0; color: var(--cond); } .c-high { background: #fde8e7; color: var(--nogo); }
  .c-modify { background: #e8efff; color: var(--accent); } .c-new { background: #eef0f4; color: var(--ink-2); }
  .muted { color: var(--ink-3); }
  .small { font-size: 8pt; }
  .callout { border-left: 3px solid var(--accent); padding: 6pt 10pt; background: #f3f6ff; border-radius: 0 6pt 6pt 0; break-inside: avoid; }
  .appendix { margin-top: 22pt; padding-top: 10pt; border-top: 1px solid var(--rule); font-size: 8pt; color: var(--ink-3); }
</style>
</head>
<body>
{% set verdict_class = {"Go": "v-go", "Go with conditions": "v-cond", "Needs more evidence": "v-more", "No-go": "v-nogo"}[r.verdict] %}

<div class="cover">
  <div class="eyebrow">Idea evaluation · {{ product.name if product else "Unassigned product" }}</div>
  <h1>{{ idea.title }}</h1>
  <div class="meta">
    <div>Prepared<b>{{ generated_on }}</b></div>
    <div>Requested by<b>{{ author or "—" }}</b></div>
    <div>Code evidence<b>{% if meta.commit %}{{ repo_name }} @ {{ meta.commit[:8] }}{% else %}No repository connected{% endif %}</b></div>
    <div>Size · duration<b>{{ r.size }} · {{ total_weeks }} weeks</b></div>
  </div>
</div>

<div class="headline">
  <div class="summary">{{ r.executive_summary }}</div>
  <div class="verdict {{ verdict_class }}">
    <div>
      <div class="label">Recommendation</div>
      <div class="value">{{ r.verdict }}</div>
    </div>
    <div class="score">{{ "%.1f"|format(meta.overallScore) }}<small> / 10</small></div>
  </div>
</div>

<section>
  <h2><span class="n">01</span>Scorecard</h2>
  <div class="scores">
    {% for key, label, hint in score_rows %}
      {% set s = r.scores[key] %}
      <div class="score-row">
        <div class="name">{{ label }}<small>{{ hint }}</small></div>
        <div class="bar"><i class="{{ 'inv' if key in ('effort', 'risk') }}" style="width: {{ s.score * 10 }}%"></i></div>
        <div class="num">{{ s.score }}</div>
        <div class="rationale">{{ s.rationale }}</div>
      </div>
    {% endfor %}
  </div>
</section>

<section>
  <h2><span class="n">02</span>Problem and users</h2>
  <p>{{ r.problem }}</p>
  <div class="two">
    <div class="card">
      <h3>Who it is for</h3>
      <ul class="clean">{% for u in r.target_users %}<li>{{ u }}</li>{% endfor %}</ul>
    </div>
    <div class="card">
      <h3>How we will know it worked</h3>
      <ul class="clean">{% for m in r.success_metrics %}<li>{{ m }}</li>{% endfor %}</ul>
    </div>
  </div>
  <h3>Value hypothesis</h3>
  <div class="callout">{{ r.value_hypothesis }}</div>
</section>

<section>
  <h2><span class="n">03</span>Technical feasibility</h2>
  <h3>Today</h3>
  <p>{{ r.current_state }}</p>
  <h3>Proposed approach</h3>
  <p>{{ r.proposed_approach }}</p>
  {% if r.affected_areas %}
  <h3>Where the change lands</h3>
  <table>
    <thead><tr><th style="width:44%">Path</th><th style="width:11%">Change</th><th>What changes</th></tr></thead>
    <tbody>
    {% for a in r.affected_areas %}
      <tr><td><code>{{ a.path }}</code></td><td><span class="chip c-{{ a.kind }}">{{ a.kind }}</span></td><td>{{ a.change }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
  <h3>Architecture impact</h3>
  <p>{{ r.architecture_impact }}</p>
  <div class="two">
    <div class="card">
      <h3>Data model changes</h3>
      {% if r.data_model_changes %}<ul class="clean">{% for d in r.data_model_changes %}<li>{{ d }}</li>{% endfor %}</ul>{% else %}<p class="muted">None.</p>{% endif %}
    </div>
    <div class="card">
      <h3>New dependencies</h3>
      {% if r.new_dependencies %}<ul class="clean">{% for d in r.new_dependencies %}<li>{{ d }}</li>{% endfor %}</ul>{% else %}<p class="muted">None.</p>{% endif %}
    </div>
  </div>
  {% if r.alternatives %}
  <h3>Alternatives considered</h3>
  <table>
    <thead><tr><th style="width:35%">Option</th><th>Trade-off</th></tr></thead>
    <tbody>{% for a in r.alternatives %}<tr><td>{{ a.option }}</td><td>{{ a.tradeoff }}</td></tr>{% endfor %}</tbody>
  </table>
  {% endif %}
</section>

<section>
  <h2><span class="n">04</span>Risks</h2>
  <table>
    <thead><tr><th style="width:30%">Risk</th><th style="width:11%">Likelihood</th><th style="width:11%">Impact</th><th>Mitigation</th></tr></thead>
    <tbody>
    {% for k in r.risks %}
      <tr>
        <td><b>{{ k.title }}</b></td>
        <td><span class="chip c-{{ k.likelihood|lower }}">{{ k.likelihood }}</span></td>
        <td><span class="chip c-{{ k.impact|lower }}">{{ k.impact }}</span></td>
        <td>{{ k.mitigation }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2><span class="n">05</span>Delivery plan</h2>
  <p><b>Team:</b> {{ r.team|join(", ") }}</p>
  <table>
    <thead><tr><th style="width:26%">Phase</th><th style="width:10%">Weeks</th><th>Deliverables</th></tr></thead>
    <tbody>
    {% for p in r.phases %}
      <tr><td><b>{{ p.name }}</b></td><td>{{ p.weeks|round(1) }}</td><td><ul class="clean">{% for d in p.deliverables %}<li>{{ d }}</li>{% endfor %}</ul></td></tr>
    {% endfor %}
      <tr><td><b>Total</b></td><td><b>{{ total_weeks }}</b></td><td class="muted">Sequential estimate; phases may overlap with a larger team.</td></tr>
    </tbody>
  </table>
</section>

<section>
  <h2><span class="n">06</span>Assumptions and open questions</h2>
  <div class="two">
    <div class="card">
      <h3>Assumptions (not verified)</h3>
      {% if r.assumptions %}<ul class="clean">{% for a in r.assumptions %}<li>{{ a }}</li>{% endfor %}</ul>{% else %}<p class="muted">None.</p>{% endif %}
    </div>
    <div class="card">
      <h3>Open questions</h3>
      {% if r.open_questions %}<ul class="clean">{% for q in r.open_questions %}<li>{{ q }}</li>{% endfor %}</ul>{% else %}<p class="muted">None.</p>{% endif %}
    </div>
  </div>
</section>

<section>
  <h2><span class="n">07</span>Recommendation</h2>
  <p><b>{{ r.verdict }}.</b> Overall score {{ "%.1f"|format(meta.overallScore) }} out of 10.</p>
  {% if r.conditions %}
  <h3>Conditions for approval</h3>
  <ul class="clean">{% for c in r.conditions %}<li>{{ c }}</li>{% endfor %}</ul>
  {% endif %}
  <h3>Next steps</h3>
  <ol class="clean">{% for s in r.next_steps %}<li>{{ s }}</li>{% endfor %}</ol>
</section>

<div class="appendix">
  <b>How this report was made.</b>
  {% if meta.commit %}The repository {{ meta.repoUrl }} was read at commit {{ meta.commit }} and compressed with repomix; every
  file path in section 03 was checked against that commit by the platform, not by the model.{% else %}No repository was connected, so the technical assessment rests on the idea text alone.{% endif %}
  The overall score is computed by the platform:
  {% for key, label, hint in score_rows %}{{ label|lower }} {{ (meta.weights[key] * 100)|round|int }}%{{ ", " if not loop.last }}{% endfor %},
  with effort and risk inverted (11 − score). Written by {{ meta.model }}; AI-generated and pending human review.
</div>
</body>
</html>
