+++ b/invoicekit/discounts.py
@@ -0,0 +1,37 @@
+"""Percentage discount codes with expiry."""
+
+from __future__ import annotations
+
+import datetime as dt
+from dataclasses import dataclass
+from decimal import Decimal
+
+
+class DiscountExpired(ValueError):
+    """Raised when a discount code is used after its expiry date."""
+
+
+@dataclass(frozen=True)
+class DiscountCode:
+    """A percentage discount applied to the subtotal before tax.
+
+    Attributes:
+        code: Identifier shown on the invoice for audit.
+        percent: Percentage off, between 0 and 100.
+        expires_on: Last day the code may be used (inclusive).
+    """
+
+    code: str
+    percent: Decimal
+    expires_on: dt.date
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.percent, Decimal):
+            raise TypeError("percent must be a Decimal")
+        if not Decimal(0) <= self.percent <= Decimal(100):
+            raise ValueError("percent must be between 0 and 100")
+
+    def check_valid(self, today: dt.date) -> None:
+        """Raises DiscountExpired if the code cannot be used on ``today``."""
+        if today > self.expires_on:
+            raise DiscountExpired(f"{self.code} expired on {self.expires_on.isoformat()}")
